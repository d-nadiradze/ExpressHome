# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/myhome_parser"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-here"

# Encryption key for myhome passwords (exactly 32 chars)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session duration in seconds (default: 24 hours)
SESSION_DURATION=86400

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DESCRIPTION_TEMPLATE_FALLBACK=true

# Google OAuth (per-user Sheets access)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/auth/callback"

# Redis (BullMQ job queue + prefill progress). Start with: npm run redis:up
REDIS_URL="redis://localhost:6379"

# Prefill/parse workers (run in a second terminal: npm run worker:dev)
# PREFILL_MAX_CONCURRENT=3
# PARSE_MAX_CONCURRENT=3
# BROWSER_MAX_CONCURRENT=1
# BROWSER_LOGIN_MAX_CONCURRENT=1

# API prefill (HTTP). A failed API prefill fails the job so the queue keeps
# moving; set *_FALLBACK=true to retry it in the browser wizard instead, which
# occupies the single Chromium slot and stalls every listing queued behind it.
# MYHOME_API_PREFILL=true
# MYHOME_API_PREFILL_FALLBACK=false
# MYHOME_PREFILL_HEADLESS=true
# MYHOME_AUTO_PUBLISH=true
# SSGE_API_PREFILL=true
# SSGE_API_PREFILL_FALLBACK=false
# SSGE_PREFILL_HEADLESS=true
# SSGE_AUTO_PUBLISH=true
# SSGE_TOKEN_CACHE=true
# SSGE_TOKEN_CACHE_SKEW_MS=120000
# SSGE_HTTP_AUTH=true

# myhome photo pre-upload: photos are uploaded to myhome in the background right
# after a parse (or a photo edit), so the prefill skips the slow upload step.
# MYHOME_PREUPLOAD=true
# MYHOME_PREUPLOAD_MAX_CONCURRENT=2
# MYHOME_PREUPLOAD_JOB_TIMEOUT_MS=600000
# MYHOME_PREUPLOAD_WAIT_MS=120000      # prefill waits this long for an in-flight pre-upload
# MYHOME_PREUPLOAD_LOCK_TTL_S=600
# MYHOME_IMAGE_UPLOAD_TIMEOUT_MS=60000 # per-photo timeout (myhome uploads are slow)
# Optional: Bearer JWT for api-gateway when home.ss.ge HTML is blocked on the VPS.
# Prefer linking an ss.ge account in the dashboard; this is a last-resort override.
# SSGE_API_BEARER=
# When Cloudflare challenges Node's fetch on home.ss.ge (VPS IPs), the guest
# token page is fetched via curl, then headless Chromium. Both on by default.
# SSGE_CURL_FALLBACK=true
# SSGE_BROWSER_FALLBACK=true
# SSGE_CHALLENGE_BROWSER_TIMEOUT_MS=30000
# SSGE_CHALLENGE_BROWSER_SLOT_WAIT_MS=10000
# SSGE_GUEST_TOKEN_RETRY_MS=300000
# SSGE_ACCOUNT_LOGIN_RETRY_MS=600000
# myhome: the tnet statements API answers 401 to anonymous clients since
# 2026-10-09; after a 401/403 the parser reads the listing page (__NEXT_DATA__)
# through the same fetch → curl → Chromium chain for this long before re-trying
# the API. The market poller skips myhome for the same period.
# MYHOME_API_AUTH_RETRY_MS=900000
# Hosts that challenged fetch+curl go straight to Chromium for this long.
# CHALLENGE_SKIP_PLAIN_TTL_MS=600000
# How long a browser-solved cf_clearance cookie is replayed by plain fetch.
# CHALLENGE_CLEARANCE_TTL_MS=1500000
# PLAYWRIGHT_CHROMIUM_CHANNEL=chromium   # full Chromium instead of headless shell

# Owner / special-statements cache (worker polls myhome + ss.ge JSON APIs)
# MARKET_POLL_ENABLED=true
# MARKET_POLL_INTERVAL_MS=720000
# MARKET_POLL_OWNER_PAGES=2
# MARKET_POLL_AGENCY_PAGES=4
# MARKET_NEW_WINDOW_MS=172800000
