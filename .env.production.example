# === Docker Compose Environment ===
# These variables are used by docker-compose.yml

# MySQL
MYSQL_ROOT_PASSWORD=change-this-strong-root-password
MYSQL_PASSWORD=change-this-strong-app-password

# App
APP_URL=https://makler.solutions

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-strong-random-secret-here

# Encryption key for myhome passwords (exactly 32 chars)
ENCRYPTION_KEY=change-this-to-exactly-32-chars!

# Google OAuth (per-user Sheets access)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://makler.solutions/api/google/auth/callback

# Redis is set in docker-compose.yml (redis://redis:6379) for app + worker services.

# Prefill worker (defaults are ON in docker-compose.yml — omit these unless overriding)
# MYHOME_API_PREFILL=true
# MYHOME_API_PREFILL_FALLBACK=false
# MYHOME_PREFILL_HEADLESS=true
# MYHOME_AUTO_PUBLISH=true
# SSGE_API_PREFILL=true
# SSGE_API_PREFILL_FALLBACK=false
# SSGE_PREFILL_HEADLESS=true
# SSGE_AUTO_PUBLISH=true
# SSGE_TOKEN_CACHE=true
# SSGE_TOKEN_CACHE_SKEW_MS=120000
# SSGE_HTTP_AUTH=true
# PREFILL_MAX_CONCURRENT=3
# PARSE_MAX_CONCURRENT=3

# myhome photo pre-upload (default ON): photos go to myhome in the background
# right after a parse, so the prefill skips the slow upload step.
# MYHOME_PREUPLOAD=true
# MYHOME_PREUPLOAD_MAX_CONCURRENT=2
# MYHOME_PREUPLOAD_JOB_TIMEOUT_MS=600000
# MYHOME_PREUPLOAD_WAIT_MS=120000
# MYHOME_IMAGE_UPLOAD_TIMEOUT_MS=60000
# Optional when home.ss.ge HTML is blocked for the VPS IP (HTTP 403).
# Prefer a linked ss.ge account in the dashboard; this is a last-resort Bearer.
# SSGE_API_BEARER=
# Cloudflare-challenge fallbacks for the ss.ge guest token page (default on):
# plain fetch → curl → headless Chromium. Token is cached ~50 min once obtained.
# SSGE_CURL_FALLBACK=true
# SSGE_BROWSER_FALLBACK=true
# SSGE_CHALLENGE_BROWSER_TIMEOUT_MS=30000
# Chromium tier gives up quickly if a prefill holds the only browser slot.
# SSGE_CHALLENGE_BROWSER_SLOT_WAIT_MS=10000
# After the chain fails, skip retries for a while instead of re-running
# Chromium/logins for every market slice and parse.
# SSGE_GUEST_TOKEN_RETRY_MS=300000
# SSGE_ACCOUNT_LOGIN_RETRY_MS=600000
# Images set PLAYWRIGHT_CHROMIUM_CHANNEL=chromium (full Chromium, new-headless);
# the headless shell fails Cloudflare's challenge from datacenter IPs.
# myhome: api-statements.tnet.ge answers 401 to anonymous clients since
# 2026-10-09. Parses fall back to the listing page (__NEXT_DATA__) via the same
# chain — on the VPS that is the Chromium tier (~4-7 s). After a 401/403 the
# API is skipped for this long; the market poller skips myhome likewise.
# MYHOME_API_AUTH_RETRY_MS=900000
# Hosts that challenged fetch+curl go straight to Chromium for this long.
# CHALLENGE_SKIP_PLAIN_TTL_MS=600000
# How long a browser-solved cf_clearance cookie is replayed by plain fetch.
# CHALLENGE_CLEARANCE_TTL_MS=1500000

# Protections for small VPS (defaults match docker-compose.yml)
# BROWSER_MAX_CONCURRENT=1
# BROWSER_LOGIN_MAX_CONCURRENT=1
# BROWSER_LOGIN_MAX_WAIT_MS=45000
# APP_MEM_LIMIT=280m
# WORKER_MEM_LIMIT=320m
# MYSQL_MEM_LIMIT=220m
# REDIS_MEM_LIMIT=64m
# NGINX_MEM_LIMIT=32m

# If an older server .env sets MYHOME_API_PREFILL=false, SSGE_API_PREFILL=false or
# SSGE_HTTP_AUTH=false, remove those lines (or set true) so GitHub deploy picks up
# API prefill defaults (SSGE_HTTP_AUTH=true keeps ss.ge auth browser-free).

# === Deployment Instructions ===
#
# 1. Copy this file to .env on your VPS:
#    cp .env.production.example .env
#
# 2. Replace ALL placeholder values with real secrets
#
# 3. Replace "makler.solutions" in nginx/default.conf with your actual domain
#
# 4. Start the stack:
#    docker compose up -d
#
# 5. Run database migrations:
#    docker compose exec app npx prisma db push
#
# 6. Set up SSL (after DNS is pointing to your server):
#    chmod +x deploy/setup-ssl.sh
#    ./deploy/setup-ssl.sh your-email@example.com
#
#    This requests a Let's Encrypt certificate and switches nginx to HTTPS.
#    Update APP_URL and GOOGLE_OAUTH_REDIRECT_URI to https://makler.solutions in .env
#
# 7. View logs:
#    docker compose logs -f app
#
# 8. Rebuild after code changes:
#    docker compose up -d --build app
