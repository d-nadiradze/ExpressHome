# Dependencies
node_modules/

# Next.js build
.next/
out/

# Environment variables
.env
.env.local
.env.production

# Database
prisma/*.db

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.cursor/

# Docker volumes
certbot/
mysql-data/

# Debug/spike scripts stay local; the CI test runner has to ship. (A negation
# cannot re-include anything under an excluded directory, hence `scripts/*`.)
scripts/*
!scripts/run-tests.ts
# The ss.ge token relay runs on a separate (residential) machine from a checkout.
!scripts/ssge-token-relay.ts
!scripts/ssge-token-relay.ps1
.env.relay
# Built by the Dockerfile from src/relay/client.ts (install.ps1/launcher.ps1 are sources).
public/relay/ssge-relay.cjs
public/relay/version.txt

# Uploaded listing images
data/uploads/

# Network-capture artifacts (HAR/JSONL may contain auth tokens — never commit)
captures/

# Misc
*.log
npm-debug.log*
