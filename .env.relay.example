# ss.ge token relay client (scripts/ssge-token-relay.ts). Copy to .env.relay on
# the machine that runs the relay — a normal home/office connection, not a
# server/datacenter IP. See scripts/ssge-token-relay.ps1 for a Windows launcher.
SSGE_RELAY_URL=https://makler.solutions
# Must equal SSGE_RELAY_SECRET in the server's .env (any long random string).
SSGE_RELAY_SECRET=
# Optional tuning
# SSGE_RELAY_MAX_LOGINS=8
# SSGE_RELAY_LOGIN_PAUSE_MS=1500
